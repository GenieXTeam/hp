<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
<meta name="theme-color" content="#08050d"/>
<title>GeniesX - Your Wish Is Becoming a Marketplace</title>
<meta name="description" content="GeniesX connects Genies (creators) with Wishers (fans) through custom requests, subscriptions and secure payouts. Join free, build your profile, and claim your $50 early-access bonus.">
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root{
    --bg: #08050d;
    --bg-soft: #0e0817;
    --surface: #150e22;
    --surface-2: #1c1330;
    --border: rgba(168, 116, 255, .16);
    --border-strong: rgba(168, 116, 255, .32);
    --violet: #a855f7;
    --violet-deep: #7c3aed;
    --magenta: #ff4fa0;
    --text: #f3eefb;
    --text-dim: #b6a9cf;
    --text-faint: #6f6489;
    --led: #38f5a5;
    --line-w: 2px;
  }

  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html{scroll-behavior:smooth;overflow-x:hidden;width:100%;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    overflow-x:hidden;
    width:100%;
    position:relative;
    line-height:1.5;
  }
  img,svg{display:block;max-width:100%;}
  a{color:inherit;}
  button{font:inherit;color:inherit;}
  ::selection{ background:rgba(168,85,247,.4); color:#fff; }

  body::before{
    content:'';
    position:fixed;
    inset:0;
    background-image:
      linear-gradient(rgba(168,116,255,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(168,116,255,.045) 1px, transparent 1px);
    background-size:64px 64px;
    pointer-events:none;
    z-index:0;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 40%, transparent 90%);
  }

  .mono{font-family:'JetBrains Mono', monospace;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px;}

  /* ===== NAV ===== */
  header{
    position:fixed; top:0; left:0; right:0; z-index:900;
    background:rgba(8,5,13,.55);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
  }
  nav{
    max-width:1180px; margin:0 auto; padding:16px 24px;
    display:flex; align-items:center; justify-content:space-between; gap:20px;
  }
  .logo{
    display:flex; align-items:center; gap:9px;
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:19px; letter-spacing:-.01em;
    text-decoration:none;
  }
  .logo .mark{
    width:26px; height:26px; border-radius:8px;
    background:linear-gradient(135deg, var(--violet-deep), var(--magenta));
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 18px rgba(168,85,247,.55);
    flex:none;
  }
  .logo .mark svg{ width:14px; height:14px; }
  .logo b{ color:var(--text); }
  .logo b span{
    background:linear-gradient(90deg, var(--violet), var(--magenta));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .nav-links{ display:flex; align-items:center; gap:30px; list-style:none; }
  .nav-links a{
    text-decoration:none; color:var(--text-dim); font-size:14px; font-weight:500;
    transition:color .2s ease;
  }
  .nav-links a:hover{ color:var(--text); }
  .nav-cta{ display:flex; align-items:center; gap:12px; }
  .btn-ghost{
    display:inline-flex; align-items:center; gap:8px;
    background:transparent; border:1px solid var(--border-strong); color:var(--text);
    font-size:13.5px; font-weight:600; padding:10px 18px; border-radius:100px;
    text-decoration:none; cursor:pointer; transition:border-color .2s ease, background .2s ease;
    white-space:nowrap;
  }
  .btn-ghost:hover{ border-color:var(--violet); background:rgba(168,116,255,.08); }
  .btn-solid{
    display:inline-flex; align-items:center; gap:8px;
    background:linear-gradient(90deg, var(--violet-deep), var(--magenta));
    color:#fff; text-decoration:none; font-family:'JetBrains Mono', monospace;
    font-weight:600; font-size:13.5px; letter-spacing:.02em;
    padding:11px 20px; border-radius:100px; border:none; cursor:pointer;
    box-shadow:0 0 0 1px rgba(255,255,255,.08) inset, 0 12px 30px -10px rgba(168,85,247,.65);
    transition:transform .25s ease, box-shadow .25s ease;
    white-space:nowrap;
  }
  .btn-solid:hover{ transform:translateY(-2px); box-shadow:0 0 0 1px rgba(255,255,255,.12) inset, 0 16px 36px -10px rgba(255,79,160,.7); }
  .btn-solid.lg{ padding:16px 30px; font-size:14.5px; }
  .hero-ctas .btn-solid.lg{ animation:cta-pulse 2.6s ease-in-out infinite; }
  .hero-ctas .btn-solid.lg:hover{ animation-play-state:paused; }
  @keyframes cta-pulse{
    0%,100%{ box-shadow:0 0 0 1px rgba(255,255,255,.08) inset, 0 12px 30px -10px rgba(168,85,247,.65); }
    50%{ box-shadow:0 0 0 1px rgba(255,255,255,.1) inset, 0 16px 46px -8px rgba(255,79,160,.85); }
  }
  @media (prefers-reduced-motion: reduce){ .hero-ctas .btn-solid.lg{ animation:none; } }
  .btn-ghost.lg{ padding:15px 28px; font-size:14.5px; }
  .menu-toggle{ display:none; background:none; border:1px solid var(--border-strong); border-radius:10px; width:40px; height:40px; align-items:center; justify-content:center; cursor:pointer; }
  .menu-toggle svg{ width:18px; height:18px; }

  .ticker{
    position:relative; overflow:hidden; border-top:1px solid var(--border);
    background:rgba(168,116,255,.05); padding:9px 0;
  }
  .ticker-track{ display:flex; width:max-content; gap:44px; white-space:nowrap; animation:ticker-scroll 26s linear infinite; }
  .ticker-track span{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--text-dim);
  }
  .ticker-track span b{ color:var(--led); font-weight:600; }
  .ticker-track span::before{ content:'✦'; color:var(--violet); }
  @keyframes ticker-scroll{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }
  @media (prefers-reduced-motion: reduce){ .ticker-track{ animation:none; } }

  @media (max-width: 900px){
    .nav-links{ display:none; }
    .nav-cta .btn-ghost{ display:none; }
    .menu-toggle{ display:flex; }
  }
  @media (max-width: 560px){
    .nav-cta .role-toggle{ display:none !important; }
    .nav-cta [data-audience]{ display:none !important; }
  }
  .nav-role-mobile{ display:none; }
  @media (min-width: 901px){ .nav-role-mobile{ display:none !important; } }

  /* ===== HERO ===== */
  .hero{
    position:relative; min-height:100vh; min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:172px 24px 60px; overflow:hidden;
  }
  #particles{ position:absolute; inset:0; z-index:1; opacity:.7; pointer-events:none; }
  .glow-orb{
    position:absolute; border-radius:50%; filter:blur(90px); opacity:.5; z-index:0;
    animation:drift 16s ease-in-out infinite alternate;
  }
  .glow-orb.a{ width:520px; height:520px; background:var(--violet-deep); top:-140px; left:-160px; }
  .glow-orb.b{ width:460px; height:460px; background:var(--magenta); bottom:-180px; right:-140px; animation-delay:-6s; }
  @keyframes drift{ from{ transform:translate(0,0) scale(1);} to{ transform:translate(30px,-20px) scale(1.08);} }

  .hero-content{ position:relative; z-index:2; max-width:840px; }
  .eyebrow{
    display:inline-flex; align-items:center; gap:10px;
    font-family:'JetBrains Mono', monospace; font-size:12.5px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--violet); background:rgba(168,116,255,.08); border:1px solid var(--border-strong);
    padding:7px 16px; border-radius:100px; margin-bottom:30px;
  }
  .eyebrow .dot{ width:6px; height:6px; border-radius:50%; background:var(--led); box-shadow:0 0 8px var(--led); animation:pulse-dot 1.8s ease-in-out infinite; }
  @keyframes pulse-dot{ 0%,100%{opacity:1;} 50%{opacity:.3;} }

  .hero h1{
    font-family:'Space Grotesk', sans-serif; font-weight:700;
    font-size:clamp(38px, 6.6vw, 74px); line-height:1.05; letter-spacing:-.02em;
    background:linear-gradient(180deg, #ffffff 20%, #cdb7f5 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    margin-bottom:20px;
  }
  .hero h1 span{
    background:linear-gradient(90deg, var(--violet), var(--magenta));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero p.lead{ font-size:clamp(16px, 2vw, 19px); color:var(--text-dim); max-width:600px; margin:0 auto 40px; line-height:1.65; }

  .hero-ctas{ display:flex; gap:14px; flex-wrap:wrap; justify-content:center; margin-bottom:40px; }

  .hero-meta{
    display:flex; gap:26px; flex-wrap:wrap; justify-content:center;
    font-family:'JetBrains Mono', monospace; font-size:12.5px; color:var(--text-faint);
  }
  .hero-meta div{ display:flex; align-items:center; gap:8px; }
  .hero-meta b{ color:var(--text); font-weight:600; }
  .hero-meta .sep{ width:3px; height:3px; border-radius:50%; background:var(--text-faint); }

  .scroll-cue{
    margin-top:56px;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    color:var(--text-faint); font-family:'JetBrains Mono', monospace; font-size:11px;
    letter-spacing:.14em; text-transform:uppercase; z-index:2;
  }
  .scroll-cue svg{ animation:bob 1.8s ease-in-out infinite; }
  @keyframes bob{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(8px);} }

  /* ===== SECTION SHELL ===== */
  section{ position:relative; z-index:1; padding:110px 0; }
  .section-head{ text-align:center; max-width:640px; margin:0 auto 56px; }
  .label{
    display:inline-block; font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:.2em;
    text-transform:uppercase; margin-bottom:16px;
    background:linear-gradient(90deg, var(--violet), var(--magenta));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .section-head h2{
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:clamp(28px,4.4vw,44px);
    letter-spacing:-.02em; margin-bottom:14px; color:var(--text);
  }
  .section-head p{ color:var(--text-dim); font-size:16px; line-height:1.65; }

  .reveal{ opacity:0; transform:translateY(24px); transition:opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  .reveal.in-view{ opacity:1; transform:translateY(0); }

  /* ===== PATHS (signature split) ===== */
  .paths{ display:grid; grid-template-columns:1fr 1fr; gap:2px; border-radius:26px; overflow:hidden; border:1px solid var(--border-strong); background:var(--border-strong); }
  .path-card{
    position:relative; background:linear-gradient(180deg, var(--surface), var(--bg-soft));
    padding:52px 42px; overflow:hidden; text-align:left;
    transition:background .4s ease;
  }
  .path-card::before{
    content:''; position:absolute; inset:-60% -20% auto auto; width:340px; height:340px; border-radius:50%;
    filter:blur(90px); opacity:.35; z-index:0; transition:opacity .4s ease;
  }
  .path-card.genie::before{ background:var(--violet); top:-40%; right:-10%; }
  .path-card.wisher::before{ background:var(--magenta); top:-40%; left:-10%; }
  .path-card:hover::before{ opacity:.55; }
  .path-card:hover{ background:linear-gradient(180deg, var(--surface-2), var(--bg-soft)); }
  .path-icon{
    position:relative; z-index:1; width:52px; height:52px; border-radius:16px; margin-bottom:26px;
    display:flex; align-items:center; justify-content:center;
  }
  .path-card.genie .path-icon{ background:linear-gradient(135deg, var(--violet-deep), var(--violet)); box-shadow:0 0 24px rgba(168,85,247,.4); }
  .path-card.wisher .path-icon{ background:linear-gradient(135deg, var(--magenta), #ff8fc4); box-shadow:0 0 24px rgba(255,79,160,.4); }
  .path-icon svg{ width:24px; height:24px; color:#fff; }
  .path-tag{
    position:relative; z-index:1; display:inline-block; font-family:'JetBrains Mono', monospace; font-size:11px;
    letter-spacing:.14em; text-transform:uppercase; color:var(--text-faint); margin-bottom:10px;
  }
  .path-card h3{ position:relative; z-index:1; font-family:'Space Grotesk', sans-serif; font-size:28px; font-weight:700; letter-spacing:-.01em; margin-bottom:14px; }
  .path-card p{ position:relative; z-index:1; color:var(--text-dim); font-size:15px; line-height:1.65; margin-bottom:26px; max-width:380px; }
  .path-list{ position:relative; z-index:1; list-style:none; margin-bottom:32px; display:flex; flex-direction:column; gap:11px; }
  .path-list li{ display:flex; align-items:flex-start; gap:10px; font-size:14px; color:var(--text-dim); }
  .path-list svg{ flex:none; width:16px; height:16px; margin-top:2px; color:var(--led); }
  .path-card .btn-solid, .path-card .btn-ghost{ position:relative; z-index:1; }
  .path-card.wisher .btn-solid{ background:linear-gradient(90deg, var(--magenta), #ff8fc4); box-shadow:0 0 0 1px rgba(255,255,255,.08) inset, 0 12px 30px -10px rgba(255,79,160,.65); }

  @media (max-width: 860px){
    .paths{ grid-template-columns:1fr; }
    .path-card{ padding:38px 26px; }
  }

  /* ===== TIMELINE (3 steps) ===== */
  .timeline{ position:relative; max-width:960px; margin:0 auto; }
  .rail{
    position:absolute; left:29px; top:6px; bottom:6px; width:var(--line-w);
    background:linear-gradient(180deg, transparent 0%, var(--border-strong) 6%, var(--border-strong) 94%, transparent 100%);
    z-index:0;
  }
  .tl-step{ position:relative; display:flex; gap:28px; padding:0 0 52px; z-index:1; }
  .tl-step:last-child{ padding-bottom:0; }
  .tl-node{
    flex:none; position:relative; z-index:2; width:60px; height:60px; border-radius:50%;
    background:var(--bg-soft); border:1px solid var(--border-strong);
    display:flex; align-items:center; justify-content:center;
    font-family:'JetBrains Mono', monospace; font-weight:600; font-size:18px; color:var(--violet);
    box-shadow:0 0 0 6px var(--bg), 0 0 22px rgba(168,116,255,.2);
    transition:all .5s cubic-bezier(.2,.7,.2,1);
  }
  .tl-step.in-view .tl-node{
    color:#fff; background:linear-gradient(135deg, var(--violet-deep), var(--magenta));
    box-shadow:0 0 0 6px var(--bg), 0 0 26px rgba(255,79,160,.5);
  }
  .tl-card{
    flex:1; background:linear-gradient(180deg, var(--surface), var(--bg-soft));
    border:1px solid var(--border); border-radius:18px; padding:28px 30px;
    transition:border-color .3s ease, transform .3s ease;
  }
  .tl-card:hover{ border-color:var(--border-strong); transform:translateY(-2px); }
  .tl-card h3{ font-family:'Space Grotesk', sans-serif; font-size:20px; font-weight:600; margin-bottom:8px; letter-spacing:-.01em; }
  .tl-card p{ color:var(--text-dim); font-size:15px; line-height:1.6; }

  @media (max-width: 640px){
    .rail{ left:23px; }
    .tl-node{ width:48px; height:48px; font-size:15px; }
    .tl-step{ gap:18px; }
    .tl-card{ padding:22px 20px; }
  }

  /* ===== BENEFIT GRID ===== */
  .benefits-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:18px; }
  .benefit-card{
    position:relative; background:linear-gradient(180deg, var(--surface), var(--bg-soft));
    border:1px solid var(--border); border-radius:18px; padding:28px 26px;
    transition:border-color .3s ease, transform .3s ease;
  }
  .benefit-card:hover{ border-color:var(--border-strong); transform:translateY(-2px); }
  .benefit-icon{
    width:40px; height:40px; border-radius:12px; margin-bottom:18px;
    background:rgba(168,116,255,.1); border:1px solid var(--border-strong);
    display:flex; align-items:center; justify-content:center;
  }
  .benefit-icon svg{ width:20px; height:20px; color:var(--violet); }
  .benefit-card h3{ font-family:'Space Grotesk', sans-serif; font-size:17px; font-weight:600; margin-bottom:8px; letter-spacing:-.01em; }
  .benefit-card p{ font-size:14px; color:var(--text-dim); line-height:1.6; }
  .benefit-card p b{ color:var(--text); font-weight:600; }
  .benefit-card.stat{ text-align:center; padding:36px 24px; }
  .benefit-stat{
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:44px; line-height:1; letter-spacing:-.02em;
    margin-bottom:14px;
    background:linear-gradient(90deg, var(--violet), var(--magenta));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .benefit-card.stat .benefit-icon{ margin:0 auto 18px; }
  .benefit-card.stat h3{ font-size:16px; }
  .future-tag{
    display:inline-block; font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:.1em;
    text-transform:uppercase; color:var(--text-faint); background:rgba(255,255,255,.04);
    border:1px solid var(--border); padding:3px 9px; border-radius:100px; margin-bottom:10px;
  }
  @media (max-width: 900px){ .benefits-grid{ grid-template-columns:1fr 1fr; } }
  @media (max-width: 620px){ .benefits-grid{ grid-template-columns:1fr; } }

  /* ===== BONUS BANNER ===== */
  .bonus{
    position:relative; max-width:1000px; margin:0 auto; border-radius:26px; overflow:hidden;
    border:1px solid var(--border-strong);
    background:linear-gradient(120deg, rgba(124,58,237,.18), rgba(255,79,160,.14));
    padding:56px 48px; display:flex; align-items:center; justify-content:space-between; gap:40px; flex-wrap:wrap;
  }
  .bonus::before{
    content:''; position:absolute; inset:0; z-index:0;
    background-image:linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size:34px 34px;
    mask-image:radial-gradient(ellipse 70% 100% at 30% 50%, black 30%, transparent 85%);
  }
  .bonus-left{ position:relative; z-index:1; max-width:520px; }
  .bonus-amount{
    display:flex; align-items:baseline; gap:6px; font-family:'Space Grotesk', sans-serif; font-weight:700;
    font-size:clamp(52px, 8vw, 84px); line-height:1; letter-spacing:-.02em; margin-bottom:14px;
    background:linear-gradient(90deg, #fff, var(--violet), var(--magenta));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .bonus-amount span{ font-family:'JetBrains Mono', monospace; font-size:15px; color:var(--text-dim); -webkit-text-fill-color:var(--text-dim); }
  .bonus-left h3{ font-family:'Space Grotesk', sans-serif; font-size:22px; font-weight:600; margin-bottom:10px; }
  .bonus-left p{ color:var(--text-dim); font-size:14.5px; line-height:1.6; }
  .bonus-right{ position:relative; z-index:1; flex:none; }

  @media (max-width: 720px){
    .bonus{ padding:40px 26px; flex-direction:column; text-align:left; }
  }

  /* ===== SHOWCASE (genies) ===== */
  .genie-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; }
  .genie-card{
    background:linear-gradient(180deg, var(--surface), var(--bg-soft));
    border:1px solid var(--border); border-radius:20px; overflow:hidden;
    transition:border-color .3s ease, transform .3s ease;
  }
  .genie-card:hover{ border-color:var(--border-strong); transform:translateY(-3px); }
  .genie-cover{
    height:96px; position:relative;
    background:linear-gradient(120deg, var(--violet-deep), var(--magenta));
    opacity:.8;
  }
  .genie-body{ padding:0 22px 22px; margin-top:-34px; position:relative; }
  .genie-avatar{
    width:64px; height:64px; border-radius:50%; border:3px solid var(--bg-soft);
    display:flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:20px; color:#fff;
    margin-bottom:14px;
  }
  .genie-name{ display:flex; align-items:center; gap:6px; font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:16.5px; }
  .genie-name svg{ width:15px; height:15px; color:var(--led); }
  .genie-handle{ font-family:'JetBrains Mono', monospace; font-size:12.5px; color:var(--text-faint); margin-bottom:12px; }
  .genie-tags{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; }
  .genie-tags span{
    font-size:11px; font-family:'JetBrains Mono', monospace; color:var(--text-dim);
    background:rgba(255,255,255,.04); border:1px solid var(--border); padding:4px 9px; border-radius:100px;
  }
  .genie-rate{ display:flex; align-items:center; justify-content:space-between; font-size:13px; color:var(--text-faint); }
  .genie-rate b{ color:var(--text); font-family:'JetBrains Mono', monospace; }
  .showcase-note{ text-align:center; color:var(--text-faint); font-size:12.5px; font-family:'JetBrains Mono', monospace; margin-top:34px; }
  .showcase-cta{ text-align:center; margin-top:26px; }

  @media (max-width: 900px){ .genie-grid{ grid-template-columns:1fr 1fr; } }
  @media (max-width: 600px){ .genie-grid{ grid-template-columns:1fr; } }

  /* ===== FAQ ===== */
