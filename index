<script>
  // ---------- Scroll reveal ----------
  const revealEls = document.querySelectorAll('.reveal, .tl-step');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('in-view'); io.unobserve(e.target); }
    });
  }, { threshold:.18 });
  revealEls.forEach(el=>io.observe(el));

  // ---------- Bonus counter ----------
  const counterEl = document.getElementById('bonusCounter');
  let counted = false;
  const counterObs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting && !counted){
        counted = true;
        let val = 0;
        const step = ()=>{
          val += 2;
          if(val >= 50){ counterEl.textContent = 50; return; }
          counterEl.textContent = val;
          requestAnimationFrame(step);
        };
        step();
        counterObs.disconnect();
      }
    });
  }, { threshold:.4 });
  counterObs.observe(document.getElementById('bonus-section'));

  // ---------- FAQ data (per role) + render ----------
  const faqsByRole = {
    genie: [
      ["How much do I earn on a custom Wish?", "You earn 100% - you keep whatever price you set, and GeniesX takes no cut from it."],
      ["When do I get my $50 bonus?", "It's added to your account once you complete a full Genie profile, and you can cash it out as soon as you complete your first Wish."],
      ["Can I control who sees my profile?", "Yes - full geo-blocking lets you hide your profile from specific cities, states or entire countries, and nothing is public by default."],
      ["How do I get paid?", "GeniesX supports ACH transfers through MassPay as well as crypto payouts. A virtual card option is in development."]
    ],
    wisher: [
      ["How does it work on the Wisher side?", "You make a Wish describing what you're looking for, then compare offers and prices from interested Genies before choosing. Everything stays inside one private, structured platform."],
      ["How do I pay?", "Payment happens inside GeniesX itself, alongside your request and messages with the Genie - nothing moves off-platform."],
      ["What kinds of things can I ask for?", "Custom content, private videos, subscriptions, creative services, personalized requests, consultations and more - if a Genie offers it, you can Wish for it."],
      ["Will I have support if something goes wrong?", "Yes - real people are available 24/7 to help with any questions about a request, payment or delivery."]
    ]
  };
  const faqList = document.getElementById('faqList');
  function renderFaq(role){
    const data = faqsByRole[role] || faqsByRole.genie;
    faqList.innerHTML = '';
    data.forEach(([q,a])=>{
      const item = document.createElement('div');
      item.className = 'faq-item';
      item.innerHTML = `
        <button class="faq-q">${q}
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="faq-a-wrap"><div class="faq-a-inner"><p class="faq-a">${a}</p></div></div>`;
      item.querySelector('.faq-q').addEventListener('click', ()=>{
        const wasOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(i=>i.classList.remove('open'));
        if(!wasOpen) item.classList.add('open');
      });
      faqList.appendChild(item);
    });
  }

  // ---------- Gate + role switching ----------
  const gate = document.getElementById('gate');
  const gateSkip = document.getElementById('gateSkip');
  const roleToggle = document.getElementById('roleToggle');

  const tickerByRole = {
    genie: ["Keep 100% on every custom Wish", "$50 bonus on your first complete profile", "Cash out after your first Wish", "80% / 50% subscription splits", "Full geo-blocking & privacy controls", "Dedicated account manager"],
    wisher: ["Compare Genies before you pay", "Private messaging, payment & delivery", "No algorithm - just real Wishes", "Custom content, subscriptions & more", "24/7 human support", "Your details stay private"]
  };
  const tickerTrack = document.getElementById('tickerTrack');
  function renderTicker(role){
    const items = tickerByRole[role] || tickerByRole.genie;
    const html = items.map(t=>`<span>${t}</span>`).join('');
    tickerTrack.innerHTML = html + html; // duplicated for seamless loop
  }

  function setRole(role){
    document.body.setAttribute('data-role', role);
    roleToggle.querySelectorAll('button').forEach(b=>{
      b.classList.toggle('active', b.dataset.setRole === role);
    });
    renderFaq(role);
    renderTicker(role);
  }

  document.querySelectorAll('[data-choose]').forEach(opt=>{
    opt.addEventListener('click', ()=>{
      setRole(opt.dataset.choose);
      gate.classList.add('hidden');
    });
  });
  gateSkip.addEventListener('click', ()=>{
    setRole('genie');
    gate.classList.add('hidden');
  });
  roleToggle.querySelectorAll('button').forEach(b=>{
    b.addEventListener('click', ()=>{
      setRole(b.dataset.setRole);
      window.scrollTo({ top:0, behavior:'smooth' });
    });
  });

  // ---------- Mobile menu ----------
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  menuToggle && menuToggle.addEventListener('click', ()=>{
    const open = navLinks.style.display === 'flex';
    navLinks.style.cssText = open ? '' : 'display:flex;position:absolute;top:100%;left:0;right:0;flex-direction:column;background:rgba(8,5,13,.97);padding:20px 24px;gap:18px;border-bottom:1px solid var(--border);';
  });
  document.querySelectorAll('[data-set-role-link]').forEach(link=>{
    link.addEventListener('click', (e)=>{
      e.preventDefault();
      setRole(link.dataset.setRoleLink);
      if(navLinks) navLinks.style.cssText = '';
      window.scrollTo({ top:0, behavior:'smooth' });
    });
  });

  // ---------- Particle constellation (hero, restrained) ----------
  (function(){
    const canvas = document.getElementById('particles');
    if(!canvas) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d');
    const hero = document.querySelector('.hero');
    let w,h,particles;
    const COUNT = 46;
    const COLORS = ['rgba(168,116,255,.7)','rgba(255,79,160,.6)','rgba(56,245,165,.5)'];

    function resize(){
      w = canvas.width = hero.offsetWidth;
      h = canvas.height = hero.offsetHeight;
    }
    function init(){
      particles = Array.from({length:COUNT}, ()=>({
        x: Math.random()*w, y: Math.random()*h,
        vx: (Math.random()-.5)*.25, vy: (Math.random()-.5)*.25,
        r: Math.random()*1.6+.6,
        c: COLORS[Math.floor(Math.random()*COLORS.length)]
      }));
    }
    function tick(){
      ctx.clearRect(0,0,w,h);
      particles.forEach(p=>{
        p.x += p.vx; p.y += p.vy;
        if(p.x<0||p.x>w) p.vx*=-1;
        if(p.y<0||p.y>h) p.vy*=-1;
      });
      for(let i=0;i<particles.length;i++){
        for(let j=i+1;j<particles.length;j++){
          const a=particles[i], b=particles[j];
          const d = Math.hypot(a.x-b.x, a.y-b.y);
          if(d<120){
            ctx.strokeStyle = `rgba(168,116,255,${(1-d/120)*.16})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
          }
        }
      }
      particles.forEach(p=>{
        ctx.beginPath();
        ctx.fillStyle = p.c;
        ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
        ctx.fill();
      });
      if(!reduceMotion) requestAnimationFrame(tick);
    }
    resize(); init();
    if(!reduceMotion){ requestAnimationFrame(tick); } else { tick(); }
    window.addEventListener('resize', ()=>{ resize(); init(); });
  })();
</script>
